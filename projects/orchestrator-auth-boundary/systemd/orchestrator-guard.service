[Unit]
Description=Root-owned orchestrator authorization guard
Requires=orchestrator-guard.socket
After=orchestrator-guard.socket

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/orchestrator-guard/orchestrator_guard.py
User=root
Group=root
RuntimeDirectory=orchestrator-guard
RuntimeDirectoryMode=0750
StateDirectory=orchestrator-guard
StateDirectoryMode=0700
LogsDirectory=orchestrator-guard
LogsDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/orchestrator-guard /var/log/orchestrator-guard /home/stanislav/agent-runs
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
UMask=0027
MemoryMax=1G
Restart=on-failure
RestartSec=2s
