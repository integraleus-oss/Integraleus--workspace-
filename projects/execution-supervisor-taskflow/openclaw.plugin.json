{
  "id": "execution-supervisor-taskflow",
  "name": "Execution Supervisor TaskFlow",
  "description": "Durable TaskFlow bridge for the execution-truth supervisor.",
  "version": "0.1.0",
  "contracts": {
    "tools": [
      "execution_supervisor_dispatch",
      "execution_supervisor_start",
      "execution_supervisor_recover"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "workspaceRoot": { "type": "string" },
      "supervisorPath": { "type": "string" },
      "managedRunnerPath": { "type": "string" },
      "managedAgentTimeoutSeconds": { "type": "integer", "minimum": 60, "maximum": 86400, "default": 3600 },
      "authorizedSessionKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
      "authorizedSessionPrefixes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": ["agent:main:telegram:"] },
      "authorizedSenderIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
      "delivery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "to"],
        "properties": {
          "channel": { "type": "string" },
          "accountId": { "type": "string" },
          "to": { "type": "string" },
          "threadId": { "type": "string" }
        }
      },
      "pollMs": { "type": "integer", "minimum": 1000, "maximum": 60000 }
    }
  },
  "activation": {
    "onStartup": true
  }
}
