{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/orchestrator-state-machine/1.0.0/orchestrator-state-machine.schema.json",
  "title": "Orchestrator State Machine Policy Fixture v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "task_policy",
    "ledger",
    "execution_report",
    "reviewer_report",
    "expected_outcome",
    "expected_rule_id"
  ],
  "properties": {
    "document_type": {
      "const": "policy_fixture"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "task_policy": {
      "$ref": "#/$defs/task_policy"
    },
    "ledger": {
      "$ref": "#/$defs/ledger"
    },
    "execution_report": {
      "$ref": "#/$defs/execution_report"
    },
    "reviewer_report": {
      "$ref": "#/$defs/trusted_review_projection"
    },
    "expected_outcome": {
      "$ref": "#/$defs/outcome"
    },
    "expected_rule_id": {
      "$ref": "#/$defs/rule_id"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+-]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000]+$"
    },
    "outcome": {
      "enum": [
        "REWORK",
        "ACCEPTED",
        "FAILED_INFRA",
        "ESCALATED"
      ]
    },
    "rule_id": {
      "type": "string",
      "pattern": "^R[0-9]{2}_[A-Z0-9_]+$"
    },
    "task_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "schema_version",
        "task_id",
        "spec_digest",
        "run_id",
        "mandatory_gates",
        "required_evidence",
        "infra_signature_allowlist",
        "budgets"
      ],
      "properties": {
        "document_type": {
          "const": "orchestrator_task_policy"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "task_id": {
          "$ref": "#/$defs/slug"
        },
        "spec_digest": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "$ref": "#/$defs/slug"
        },
        "mandatory_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "required_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "req_id",
              "digest",
              "digest_required"
            ],
            "properties": {
              "req_id": {
                "$ref": "#/$defs/slug"
              },
              "digest": {
                "$ref": "#/$defs/sha256"
              },
              "digest_required": {
                "type": "boolean"
              }
            }
          }
        },
        "infra_signature_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rework",
            "infra_total",
            "infra_per_signature",
            "final_full",
            "no_progress"
          ],
          "properties": {
            "rework": {
              "$ref": "#/$defs/nonnegative_integer"
            },
            "infra_total": {
              "$ref": "#/$defs/nonnegative_integer"
            },
            "infra_per_signature": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/nonnegative_integer"
              }
            },
            "final_full": {
              "$ref": "#/$defs/nonnegative_integer"
            },
            "no_progress": {
              "$ref": "#/$defs/nonnegative_integer"
            }
          }
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "schema_version",
        "task_id",
        "spec_digest",
        "run_id",
        "current_epoch",
        "last_epoch",
        "seen_nonces",
        "expected_subject",
        "counters",
        "finding_registry",
        "prior_attempts",
        "terminal_decision"
      ],
      "properties": {
        "document_type": {
          "const": "orchestrator_ledger"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "task_id": {
          "$ref": "#/$defs/slug"
        },
        "spec_digest": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "$ref": "#/$defs/slug"
        },
        "current_epoch": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "last_epoch": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "seen_nonces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "expected_subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tree_digest",
            "changed_paths"
          ],
          "properties": {
            "tree_digest": {
              "$ref": "#/$defs/sha256"
            },
            "changed_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/path"
              }
            }
          }
        },
        "counters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rework_used",
            "infra_total_used",
            "infra_used_by_signature",
            "final_full_used",
            "no_progress_streak"
          ],
          "properties": {
            "rework_used": {
              "$ref": "#/$defs/nonnegative_integer"
            },
            "infra_total_used": {
              "$ref": "#/$defs/nonnegative_integer"
            },
            "infra_used_by_signature": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/nonnegative_integer"
              }
            },
            "final_full_used": {
              "$ref": "#/$defs/nonnegative_integer"
            },
            "no_progress_streak": {
              "$ref": "#/$defs/nonnegative_integer"
            }
          }
        },
        "finding_registry": {
          "$ref": "#/$defs/finding_registry"
        },
        "prior_attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt_epoch",
              "progress_identity",
              "decision_digest",
              "outcome",
              "rule_id"
            ],
            "properties": {
              "attempt_epoch": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "progress_identity": {
                "$ref": "#/$defs/sha256"
              },
              "decision_digest": {
                "$ref": "#/$defs/sha256"
              },
              "outcome": {
                "$ref": "#/$defs/outcome"
              },
              "rule_id": {
                "$ref": "#/$defs/rule_id"
              }
            }
          }
        },
        "terminal_decision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/decision"
            }
          ]
        }
      }
    },
    "execution_report": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "payload": [
          "payload_digest"
        ],
        "payload_digest": [
          "payload"
        ]
      },
      "required": [
        "document_type",
        "schema_version",
        "task_id",
        "spec_digest",
        "run_id",
        "attempt_epoch",
        "nonce",
        "subject",
        "exit_status",
        "failure_signatures",
        "gate_results",
        "evidence_artifacts"
      ],
      "properties": {
        "document_type": {
          "const": "execution_report"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "task_id": {
          "$ref": "#/$defs/slug"
        },
        "spec_digest": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "$ref": "#/$defs/slug"
        },
        "attempt_epoch": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "nonce": {
          "$ref": "#/$defs/slug"
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tree_digest",
            "changed_paths"
          ],
          "properties": {
            "tree_digest": {
              "$ref": "#/$defs/sha256"
            },
            "changed_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/path"
              }
            }
          }
        },
        "exit_status": {
          "enum": [
            "OK",
            "FAILED"
          ]
        },
        "failure_signatures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "gate_results": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "PASS",
              "FAIL",
              "MISSING",
              "SKIPPED",
              "TIMEOUT"
            ]
          }
        },
        "evidence_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "req_id",
              "digest",
              "bytes"
            ],
            "properties": {
              "req_id": {
                "$ref": "#/$defs/slug"
              },
              "digest": {
                "$ref": "#/$defs/sha256"
              },
              "bytes": {
                "$ref": "#/$defs/nonnegative_integer"
              }
            }
          }
        },
        "payload": true,
        "payload_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "trusted_review_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "schema_version",
        "task_id",
        "spec_digest",
        "run_id",
        "attempt_epoch",
        "review_id",
        "review_digest",
        "review_mode",
        "coverage_scope",
        "reviewed_tree_digest",
        "covered_paths",
        "findings",
        "verified_finding_ids"
      ],
      "properties": {
        "document_type": {
          "const": "trusted_review_projection"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "task_id": {
          "$ref": "#/$defs/slug"
        },
        "spec_digest": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "$ref": "#/$defs/slug"
        },
        "attempt_epoch": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "review_id": {
          "$ref": "#/$defs/slug"
        },
        "review_digest": {
          "$ref": "#/$defs/sha256"
        },
        "review_mode": {
          "enum": [
            "initial_full",
            "targeted_verification",
            "final_full"
          ]
        },
        "coverage_scope": {
          "enum": [
            "full",
            "targeted"
          ]
        },
        "reviewed_tree_digest": {
          "$ref": "#/$defs/sha256"
        },
        "covered_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding_id",
              "occurrence_id",
              "severity",
              "path"
            ],
            "properties": {
              "finding_id": {
                "$ref": "#/$defs/slug"
              },
              "occurrence_id": {
                "$ref": "#/$defs/slug"
              },
              "severity": {
                "enum": [
                  "blocker",
                  "major",
                  "nit",
                  "minor",
                  "info"
                ]
              },
              "path": {
                "$ref": "#/$defs/path"
              },
              "message": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        },
        "verified_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "schema_version",
        "outcome",
        "rule_id",
        "reason_codes",
        "directives",
        "progress_identity",
        "budgets_after",
        "input_digests",
        "registry_digest_after",
        "decision_digest"
      ],
      "properties": {
        "document_type": {
          "const": "orchestrator_decision"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "rule_id": {
          "$ref": "#/$defs/rule_id"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "directives": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "progress_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "budgets_after": {
          "type": "object"
        },
        "input_digests": {
          "type": "object"
        },
        "registry_digest_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "finding_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "schema_version",
        "findings"
      ],
      "properties": {
        "document_type": {
          "const": "finding_registry"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "not": {
        "type": "boolean"
      }
    }
  }
}
