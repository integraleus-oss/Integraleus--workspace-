{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-agent-factory.local/schemas/requirements-manifest.schema.json",
  "title": "Immutable Requirements Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_type", "schema_version", "manifest_id", "revision", "previous_manifest_digest", "original_brief", "original_brief_digest", "immutable_core_digest", "requirements"],
  "allOf": [
    {
      "if": {"properties": {"revision": {"const": 1}}},
      "then": {"properties": {"previous_manifest_digest": {"type": "null"}}},
      "else": {"properties": {"previous_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
    }
  ],
  "properties": {
    "document_type": {"const": "requirements_manifest"},
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "revision": {"type": "integer", "minimum": 1},
    "previous_manifest_digest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
    "original_brief": {"type": "string", "minLength": 1, "maxLength": 65536},
    "original_brief_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "immutable_core_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 99,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "original_text", "original_text_digest", "state", "owner_disposition"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^R(?:0[1-9]|[1-9][0-9])$"},
          "original_text": {"type": "string", "minLength": 1, "maxLength": 8192},
          "original_text_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "state": {"enum": ["accepted", "implementing", "implemented", "deferred_by_user", "removed_by_user"]},
          "owner_disposition": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["decision_id", "reason"],
                "properties": {
                  "decision_id": {"type": "string", "minLength": 1, "maxLength": 128},
                  "reason": {"type": "string", "minLength": 1, "maxLength": 2048}
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"state": {"enum": ["deferred_by_user", "removed_by_user"]}}},
            "then": {"properties": {"owner_disposition": {"type": "object"}}},
            "else": {"properties": {"owner_disposition": {"type": "null"}}}
          }
        ]
      }
    }
  }
}
